# Copy to .env and fill in. Per-service .env files (heart/.env, muscles/.env,
# senses/.env, body/.env) are also supported by docker-compose.yml -- use
# whichever layout fits your setup. Nothing in this repo reads these yet
# (see docs/ARCHITECTURE.md for what's built vs planned); this documents the
# intended shape based on each service's README.

# --- brain / migrate ---
DATABASE_URL=postgresql://thea:thea@localhost:5432/thea
THEA_SCHEMA_XLSX=`../THEA DB.xlsx`

# --- heart ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
REDIS_URL=redis://localhost:6379

# --- muscles ---
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
MQTT_BROKER_URL=
ELEVENLABS_API_KEY=

# --- senses ---
PORCUPINE_ACCESS_KEY=

# --- body ---
# Reads from heart via a thin HTTP API, per thea-body's README -- not built yet.
HEART_API_URL=http://localhost:8000
