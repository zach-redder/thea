# Copy to .env (gitignored) and fill in. SECRETS AND ADDRESSES ONLY:
# THEA's behavior (model, voice, wake word, do-not-disturb, privacy mode) lives
# in the thea.config table, not here. See docs/decisions/0008-env-for-secrets-only.md.

# --- Shared -------------------------------------------------------------------
# The personal API token every client sends (web, phone, desktop, services).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
THEA_API_TOKEN=

# --- Data (agent) ---------------------------------------------------------------
DATABASE_URL=postgresql://thea:thea@localhost:5432/thea
REDIS_URL=redis://localhost:6379/0
# Location of the schema/seed source (lives OUTSIDE the repo; contains personal data).
THEA_SCHEMA_XLSX=../THEA DB.xlsx

# --- Model providers (agent) ------------------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Service addresses (agent -> actuators, perception -> agent) --------------------
VOICE_SERVICE_URL=http://localhost:8010
HOME_SERVICE_URL=http://localhost:8030
AGENT_URL=http://localhost:8000

# --- Voice ------------------------------------------------------------------------
PORCUPINE_ACCESS_KEY=
ELEVENLABS_API_KEY=
HUGGINGFACE_TOKEN=
SNAPCAST_HOST=localhost

# --- Home -------------------------------------------------------------------------
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
MQTT_BROKER_URL=mqtt://localhost:1883

# --- Vision -------------------------------------------------------------------------
# JSON list of RTSP stream URLs, e.g. ["rtsp://user:pass@cam1/stream"]
CAMERA_URLS=[]

# --- Integrations (agent) -----------------------------------------------------------
# Static credentials only. OAuth access/refresh tokens are NOT stored here: they live
# encrypted in thea.integration_credentials (docs/decisions/0009-integration-credentials.md).
# Generate the key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# OAuth app credentials (the app's identity, not your tokens)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Personal access tokens (use the narrowest scopes; read-only first)
GITHUB_TOKEN=
NOTION_TOKEN=
PLAID_CLIENT_ID=
PLAID_SECRET=

# Webhook signing secrets (GitHub, Twitch EventSub)
GITHUB_WEBHOOK_SECRET=
TWITCH_EVENTSUB_SECRET=

# Web Push to the installed phone app (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
