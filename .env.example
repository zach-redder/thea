# Copy to .env (gitignored) and fill in. SECRETS AND ADDRESSES ONLY:
# THEA's behavior (model, voice, wake word, do-not-disturb, privacy mode) lives
# in the thea.config table, not here. See docs/decisions/0008-env-for-secrets-only.md.

# --- Shared -------------------------------------------------------------------
# The personal API token every client sends (web, phone, desktop, services).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
THEA_API_TOKEN=

# --- Data (agent) ---------------------------------------------------------------
DATABASE_URL=postgresql://thea:thea@localhost:5432/thea
REDIS_URL=redis://localhost:6379/0
# Location of the schema/seed source (lives OUTSIDE the repo; contains personal data).
THEA_SCHEMA_XLSX=../THEA DB.xlsx

# --- Model providers (agent) ------------------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Service addresses (agent -> actuators, perception -> agent) --------------------
VOICE_SERVICE_URL=http://localhost:8010
HOME_SERVICE_URL=http://localhost:8030
AGENT_URL=http://localhost:8000

# --- Voice ------------------------------------------------------------------------
PORCUPINE_ACCESS_KEY=
ELEVENLABS_API_KEY=
HUGGINGFACE_TOKEN=
SNAPCAST_HOST=localhost

# --- Home -------------------------------------------------------------------------
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
MQTT_BROKER_URL=mqtt://localhost:1883

# --- Vision -------------------------------------------------------------------------
# JSON list of RTSP stream URLs, e.g. ["rtsp://user:pass@cam1/stream"]
CAMERA_URLS=[]
