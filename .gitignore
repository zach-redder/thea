# ---------------------------------------------------------------------------
# Personal data -- NEVER commit.
# THEA DB.xlsx is the schema source of truth AND holds real personal data; it
# lives beside this repo, not in it. The seed importer writes its rows to
# local_seed.sql, which is just as sensitive.
# ---------------------------------------------------------------------------
*.xlsx
**/seed/local_seed.sql
**/seed/*.local.sql

